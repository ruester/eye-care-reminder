<!--
  WiX Toolset (v5) source for the Eye Care Reminder MSI installer.
  Built by `just build-windows` from the published app in the payload
  directory (bind path "payload").

  Installs to Program Files\Eye Care Reminder, adds a Start menu shortcut and
  starts the tray app for every user at logon. The setup wizard (WixUI_InstallDir
  without the license page, plus a page to choose the app language) ends with a
  "Completed" page that can launch the app.

  Localization: Build-Msi.ps1 builds this file once per culture with
  l10n/<culture>.wxl (!(loc.*) strings) and embeds the differences as language
  transforms into the en-US MSI; Windows Installer applies the one matching the
  Windows display language automatically.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Eye Care Reminder"
           Manufacturer="Eye Care Reminder"
           Version="$(var.Version)"
           ProductCode="$(var.ProductCode)"
           Language="!(loc.Lcid)"
           UpgradeCode="5b0d7c1e-3f4a-4e8b-9c2d-6a1f0e7b3d54"
           Scope="perMachine">
    <!--
      Upgrade: install the new files first (after CloseTrayApp ended the running app),
      then remove what is left of the old version. Requires stable component GUIDs
      (WiX derives them from the install paths).
    -->
    <MajorUpgrade Schedule="afterInstallExecute"
                  DowngradeErrorMessage="!(loc.DowngradeError)" />

    <!-- The tray app is closed by CloseTrayApp below; skip the "files in use" prompt. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(sys.SOURCEFILEDIR)..\app\EyeCareReminder.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Eye Care Reminder" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component>
        <File Id="AppExe" Source="!(bindpath.payload)\EyeCareReminder.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                    Directory="ProgramMenuFolder"
                    Name="Eye Care Reminder"
                    Description="!(loc.ShortcutDescription)"
                    WorkingDirectory="INSTALLFOLDER" />
        </File>
        <!-- Start with Windows for every user (silently, in the tray). -->
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                       Name="EyeCareReminder"
                       Type="string"
                       Value="&quot;[#AppExe]&quot; --autostart" />
      </Component>
      <Component>
        <File Source="!(bindpath.payload)\EyeCareReminder.exe.config" />
      </Component>
      <!-- App language of the installing user, read by the app (Settings.cs). -->
      <Component Id="LanguageSetting" Guid="8f3e2a61-4c7d-4b9e-a0f5-2d6c1b8e7a93">
        <RegistryValue Root="HKCU"
                       Key="Software\EyeCareReminder"
                       Name="Language"
                       Type="string"
                       Value="[APPLANGUAGE]"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!--
      App language (codes as in src/windows/app/Language.cs). Default: the language of
      the applied language transform (= Windows display language), or the language chosen
      at a previous installation (the Belgian nl-BE / fr-BE of versions up to 1.3 become
      nl / fr). Silent installs can pass APPLANGUAGE=<code>.
    -->
    <Property Id="APPLANGUAGE" Value="!(loc.DefaultAppLanguage)" Secure="yes" />
    <Property Id="PREVIOUSAPPLANGUAGE">
      <RegistrySearch Id="PreviousAppLanguage" Root="HKCU" Key="Software\EyeCareReminder"
                      Name="Language" Type="raw" />
    </Property>
    <SetProperty Action="SetAppLanguagePrevious" Id="APPLANGUAGE" Value="[PREVIOUSAPPLANGUAGE]"
                 After="AppSearch" Sequence="first" Condition="PREVIOUSAPPLANGUAGE" />
    <SetProperty Action="SetAppLanguageFormerDutch" Id="APPLANGUAGE" Value="nl"
                 After="SetAppLanguagePrevious" Sequence="first"
                 Condition="PREVIOUSAPPLANGUAGE = &quot;nl-BE&quot;" />
    <SetProperty Action="SetAppLanguageFormerFrench" Id="APPLANGUAGE" Value="fr"
                 After="SetAppLanguageFormerDutch" Sequence="first"
                 Condition="PREVIOUSAPPLANGUAGE = &quot;fr-BE&quot;" />

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <!--
      Close every running instance of the tray app (any user, also elevated ones)
      at the start of the installation script, before files are replaced or
      removed, on install, upgrade, repair and uninstall. Runs as LocalSystem; taskkill fails
      harmlessly when the app is not running.
    -->
    <SetProperty Id="CloseTrayApp"
                 Value="&quot;[System64Folder]taskkill.exe&quot; /F /IM EyeCareReminder.exe"
                 Before="CloseTrayApp"
                 Sequence="execute" />
    <CustomAction Id="CloseTrayApp"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="CloseTrayApp" After="InstallInitialize" />
    </InstallExecuteSequence>

    <!-- Setup wizard: Welcome -> app language -> install folder -> Install -> Completed (no license page). -->
    <UI>
      <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LanguageDlg" Order="99" />
      <Publish Dialog="LanguageDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LanguageDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LanguageDlg" Order="99" />

      <!-- Same layout as the WixUI pages. List order and codes as in src/windows/app/Language.cs. -->
      <Dialog Id="LanguageDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}!(loc.LanguageDlgTitle)" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.LanguageDlgDescription)" />
        <Control Id="LanguageLabel" Type="Text" X="20" Y="60" Width="330" Height="15" Text="!(loc.LanguageDlgLabel)" />
        <Control Id="LanguageCombo" Type="ComboBox" X="20" Y="76" Width="160" Height="16" Property="APPLANGUAGE" ComboList="yes" Sorted="no">
          <ComboBox Property="APPLANGUAGE">
            <ListItem Value="cs" Text="!(loc.NameCzech)" />
            <ListItem Value="de" Text="Deutsch" />
            <ListItem Value="en" Text="English" />
            <ListItem Value="es" Text="!(loc.NameSpanish)" />
            <ListItem Value="fr" Text="Français" />
            <ListItem Value="hr" Text="Hrvatski" />
            <ListItem Value="it" Text="Italiano" />
            <ListItem Value="nl" Text="Nederlands" />
            <ListItem Value="nb" Text="Norsk" />
            <ListItem Value="pl" Text="Polski" />
            <ListItem Value="pt" Text="!(loc.NamePortuguese)" />
            <ListItem Value="fi" Text="Suomi" />
            <ListItem Value="sv" Text="Svenska" />
          </ComboBox>
        </Control>
        <Control Id="Hint" Type="Text" X="20" Y="104" Width="330" Height="30" NoPrefix="yes" Text="!(loc.LanguageDlgHint)" />
      </Dialog>

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <!-- "Launch Eye Care Reminder" checkbox on the Completed page (checked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.LaunchApp)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#AppExe]" />
    <CustomAction Id="LaunchApplication"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />
  </Package>
</Wix>
