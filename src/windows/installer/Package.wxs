<!--
  WiX Toolset (v5) source for the Eye Care Reminder MSI installer.
  Built by `just build-windows` from the published app in the payload
  directory (bind path "payload").

  Installs to Program Files\Eye Care Reminder, adds a Start menu shortcut and
  starts the tray app for every user at logon. The setup wizard (WixUI_InstallDir
  without the license page) ends with a "Completed" page that can launch the app.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Eye Care Reminder"
           Manufacturer="Eye Care Reminder"
           Version="$(var.Version)"
           UpgradeCode="5b0d7c1e-3f4a-4e8b-9c2d-6a1f0e7b3d54"
           Scope="perMachine">
    <!--
      Upgrade: install the new files first (after CloseTrayApp ended the running app),
      then remove what is left of the old version. Requires stable component GUIDs
      (WiX derives them from the install paths).
    -->
    <MajorUpgrade Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!-- The tray app is closed by CloseTrayApp below; skip the "files in use" prompt. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(sys.SOURCEFILEDIR)..\app\EyeCareReminder.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Eye Care Reminder" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component>
        <File Id="AppExe" Source="!(bindpath.payload)\EyeCareReminder.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                    Directory="ProgramMenuFolder"
                    Name="Eye Care Reminder"
                    Description="Reminds you to rest your eyes"
                    WorkingDirectory="INSTALLFOLDER" />
        </File>
        <!-- Start with Windows for every user (silently, in the tray). -->
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                       Name="EyeCareReminder"
                       Type="string"
                       Value="&quot;[#AppExe]&quot; --autostart" />
      </Component>
      <Component>
        <File Source="!(bindpath.payload)\EyeCareReminder.exe.config" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <!--
      Close every running instance of the tray app (any user, also elevated ones)
      at the start of the installation script, before files are replaced or
      removed, on install, upgrade, repair and uninstall. Runs as LocalSystem; taskkill fails
      harmlessly when the app is not running.
    -->
    <SetProperty Id="CloseTrayApp"
                 Value="&quot;[System64Folder]taskkill.exe&quot; /F /IM EyeCareReminder.exe"
                 Before="CloseTrayApp"
                 Sequence="execute" />
    <CustomAction Id="CloseTrayApp"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="CloseTrayApp" After="InstallInitialize" />
    </InstallExecuteSequence>

    <!-- Setup wizard: Welcome -> install folder -> Install -> Completed (no license page). -->
    <UI>
      <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="99" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="99" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <!-- "Launch Eye Care Reminder" checkbox on the Completed page (checked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Eye Care Reminder" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#AppExe]" />
    <CustomAction Id="LaunchApplication"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />
  </Package>
</Wix>
